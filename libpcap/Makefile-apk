all: apk

VERSION := $(shell cat VERSION)
BUILD_DIR := $(PWD)/NFPM_BUILD/sandbox/fx-libpcap-$(VERSION)
PREFIX := usr
AX_CONFIG := opt/axellio/config
BUILD_NUMBER ?= 0

clean:
	@rm -rf $(BUILD_DIR)

apk:
	./configure --prefix=$(BUILD_DIR)/$(PREFIX) --enable-axellio
	make
	make install
	mkdir -p $(BUILD_DIR)/$(AX_CONFIG)
	cp fx-libpcap.ini $(BUILD_DIR)/$(AX_CONFIG)/
	python gen-nfpm-yaml.py --version-file VERSION --build-dir $(BUILD_DIR) --release $(BUILD_NUMBER) > nfpm.yaml
	nfpm package -f nfpm.yaml -p apk -t fx-libpcap-$(VERSION)-r$(BUILD_NUMBER).apk
